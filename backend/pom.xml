<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot "parent" POM gives us sensible default versions for all
         the libraries below, so we don't have to pick versions ourselves. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.enviro.assessment</groupId>
    <artifactId>enviro365-withdrawal-backend</artifactId>
    <version>1.0.0</version>
    <name>enviro365-withdrawal-backend</name>
    <description>Junior Developer Assessment - Enviro365 Investments Withdrawal System</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Lets us build REST controllers (@RestController, @GetMapping etc.)
             and starts an embedded Tomcat web server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Gives us JPA / Hibernate so our Java classes (Investor, Product...)
             can be saved to and read from a database as tables -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Enables @Valid / @NotNull / @Positive style validation on our DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 is a lightweight in-memory database - perfect for this assessment
             because the marker doesn't need to install MySQL/Postgres to run it -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
